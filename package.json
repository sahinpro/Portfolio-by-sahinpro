{
  "version": "1.0.0",
  "type": "module",
  "name": "portfolio-monorepo",
  "private": true,
  "description": "Monorepo for sahinpro.me: public website, CMS admin and lead/outreach workspace (Bun workspaces)",
  "author": "Sahin Alam",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "bun run --filter @sahinpro/website dev",
    "dev:admin": "bun run --filter @sahinpro/admin dev",
    "dev:workspace": "bun run --filter @sahinpro/workspace dev",
    "build:website": "bun run --filter @sahinpro/website build",
    "build:admin": "bun run --filter @sahinpro/admin build",
    "build:workspace": "bun run --filter @sahinpro/workspace build",
    "build": "bun run build:website && bun run build:admin && bun run build:workspace",
    "type-check": "bun run --filter '*' type-check",
    "lint": "bun run --filter '*' lint",
    "test:outreach": "bun run --filter @sahinpro/workspace test:outreach",
    "test:api": "bun run --filter '*' test:api",
    "check:vercel-api": "bun run --filter '*' check:vercel-api",
    "verify": "bun run type-check && bun run lint && bun run test:outreach && bun run test:api && bun run check:vercel-api",
    "generate:favicons": "bun run --filter @sahinpro/website generate:favicons",
    "generate:sitemap": "bun run --filter @sahinpro/website generate:sitemap",
    "type-check:functions": "bunx tsc -p supabase/functions/tsconfig.json --noEmit",
    "deploy:function:record-page-view": "bunx supabase functions deploy record-page-view",
    "clean": "rm -rf apps/*/.next apps/*/tsconfig.tsbuildinfo"
  },
  "overrides": {
    "supabase": {
      "node-fetch": "2.7.0"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
