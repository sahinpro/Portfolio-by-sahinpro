{
  "version": "1.0.0",
  "type": "module",
  "name": "portfolio",
  "description": "Professional portfolio website for Sahin Alam - Full Stack Web Developer",
  "author": "Sahin Alam",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:functions": "tsc -p supabase/functions/tsconfig.json --noEmit",
    "deploy:function:record-page-view": "npx supabase functions deploy record-page-view",
    "deploy:function:submit-contact": "npx supabase functions deploy submit-contact",
    "clean": "rm -rf dist node_modules/.vite",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
