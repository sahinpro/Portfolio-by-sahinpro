    "esbuild": "^0.27.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.12.0",
    "postcss": "^8.4.47",
    "supabase": "^2.84.4",
    "tailwindcss": "3.4.16",
    "terser": "^5.46.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
