    "lottie-react": "^2.4.1",
    "lucide-react": "^0.453.0",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.16",
    "react-router-dom": "^6.8.1",
    "react-turnstile": "^1.1.5",
    "recharts": "^3.8.1",
