{
  "name": "@sahinpro/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App-neutral modules shared by the website, admin and workspace applications",
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./context/*": "./src/context/*.tsx",
    "./types/*": "./src/types/*.ts",
    "./PageSpinner": "./src/PageSpinner.tsx",
    "./ComingSoonDisplay": "./src/ComingSoonDisplay.tsx",
    "./ProjectTestimonialCard": "./src/ProjectTestimonialCard.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx eslint ."
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "~2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.453.0",
    "tailwind-merge": "2.5.4"
  },
  "peerDependencies": {
    "next": "^15.5.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/react": "18.2.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
