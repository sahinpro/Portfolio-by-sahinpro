# Copy to .env.local and fill in real values. Do not commit .env.local.
# Names only — never commit real values. Reader column = which code consumes it.

# --- Required (Supabase auth + data) ---
# Reader: @sahinpro/shared/supabase (browser client), server bearer-token check
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use one of these public keys (publishable preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Required (authorization) ---
# REQUIRED in every deployment under the current implementation: unset means
# every authenticated Supabase user passes (pre-existing fail-open documented
# in MONOREPO_MIGRATION_AUDIT.md §10) — never ship it unset.
# Reader: @sahinpro/shared/auth `isAllowedAdminEmail` — the CMS allowlist gate,
# enforced both in the protected layout and in POST /api/admin/flush-cache +
# POST /api/_revalidate.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Optional (admin shell) ---
# NEXT_PUBLIC_ADMIN_DISPLAY_NAME=
# NEXT_PUBLIC_ADMIN_AVATAR_URL=
# NEXT_PUBLIC_SUPABASE_STORAGE_QUOTA_GB=1

# --- Required (website cache flush relay, audit §11) ---
# Server-only. Never prefixed NEXT_PUBLIC_ — these must not reach a browser bundle.
# WEBSITE_URL: where the Website deployment's /api/revalidate lives. REQUIRED —
#   there is NO default. Unset ⇒ every flush answers 503
#   { revalidationFailed: true, reason: "missing_website_url" }. The value is
#   validated against a fixed origin allowlist (canonical https origin +
#   localhost dev ports) so no request can be pointed at an arbitrary host.
# REVALIDATE_SECRET: REQUIRED — sent as `x-revalidate-token`; must equal the
#   Website's own server-only REVALIDATE_SECRET. Unset ⇒ 503
#   { reason: "missing_revalidate_secret" }.
WEBSITE_URL=https://www.sahinpro.me
REVALIDATE_SECRET=
# Optional relay timeout override (ms, default 8000):
# WEBSITE_REVALIDATE_TIMEOUT_MS=8000

# --- NOT used by this app ---
# Contact form / Turnstile / Resend / page-view ingestion / Upstash Redis /
# outreach cron all belong to the Website and Workspace apps. The service-role
# key is deliberately not configured here (audit §10.6).
