# Copy to .env.local and fill in real values. Do not commit .env.local.
# Names only — never commit real values. Reader column = which code consumes it.

# --- Required (Supabase auth + CRM data) ---
# Reader: @sahinpro/shared/supabase (browser client), server bearer-token check
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use one of these public keys (publishable preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Required (authorization) ---
# REQUIRED: the shared admin gate is now FAIL-CLOSED — an unset/blank value
# denies EVERY authenticated user (admins are locked out until it is set). Set
# it to the single admin email; the previous fail-open behaviour (unset ⇒ allow
# all, audit §10) has been removed. This is especially important here because
# the outreach endpoints act with the service-role key.
# Reader: @sahinpro/shared/auth `isAllowedAdminEmail` — the allowlist gate,
# enforced in the protected layout, the login page, and every /api/admin/* + cron
# endpoint. The CRM reuses the same admin allowlist as the CMS by design —
# DB-only authz is still deferred (B1/B5).
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Optional (shell chrome) ---
# NEXT_PUBLIC_ADMIN_DISPLAY_NAME=
# NEXT_PUBLIC_ADMIN_AVATAR_URL=/sahin.jpg

# --- Server-only (outreach). NEVER prefixed NEXT_PUBLIC_. ---
# Service-role key: ONLY the outreach server routes use it (site_settings reads/
# writes + outreach_window_notifications dedupe). The browser CRM talks to
# Supabase with the anon key under RLS; the service key never reaches a client.
# Reader: src/server/lib/supabaseService.ts
# SUPABASE_SERVICE_ROLE_KEY=

# Cron contract for GET /api/cron/outreach-windows (invoked by Supabase pg_cron
# via pg_net). It now emits ONE Daily Outreach Digest per Bangladesh day (08:00
# Asia/Dhaka target; see docs/OUTREACH_DAILY_DIGEST_SCHEDULER_PROPOSAL.sql) — not
# a per-city email. Reader: src/server/api/middleware/requireCron.ts + the cron route.
# CRON_SECRET=

# Daily Outreach Digest email sender. Readers: src/server/outreach/outreachEmail.ts
# and runOutreachNotifications.ts (runDailyOutreachDigest).
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_TO_EMAIL=you@example.com
# CONTACT_NOTIFICATION_FROM_EMAIL=Sahin Alam <you@example.com>
# SITE_URL=https://workspace.sahinpro.me   (fallback NEXT_PUBLIC_SITE_URL)

# Optional fixed zone override (comma/space list). Reader: runOutreachNotifications.ts
# OUTREACH_NOTIFICATION_ZONES=

# --- NOT used by this app ---
# The Website owns the public contact form (Turnstile, rate limiting, Upstash),
# page-view ingestion, and the public-content/Redis cache layer. This app does not
# configure those. This app also does NOT relay to the website cache: no CRM or
# outreach action changes public content, so there is no WEBSITE_URL/REVALIDATE_SECRET.
