# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Required (CMS / admin) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use one of these public keys (publishable preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Required (contact form) ---
RESEND_API_KEY=re_xxx

# --- Optional: contact ---
CONTACT_NOTIFICATION_TO_EMAIL=contact@sahinpro.me
CONTACT_NOTIFICATION_FROM_EMAIL=Sahin Alam <contact@sahinpro.me>
# RESEND_CONTACT_TEMPLATE_ID=re_xxx
# CONTACT_RATE_LIMIT_PER_MINUTE=6
# CONTACT_RATE_LIMIT_WINDOW_MS=60000

# --- Recommended: Cloudflare Turnstile (site key is public, secret is server-only) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: Crisp live chat (public website instance ID) ---
# From the Crisp dashboard → Settings → Settings → Website. When unset/blank the
# chat widget is not loaded at all (no script injected).
# NEXT_PUBLIC_CRISP_WEBSITE_ID=

# --- Admin gate (fail-closed — set this if you use admin features) ---
# The Website consumes the shared admin gate @sahinpro/shared/auth
# `isAllowedAdminEmail` in two runtime paths:
#   1. the Coming Soon "admin bypass" (PublicSiteGate) so an admin can preview the
#      live site while Coming Soon is enabled; and
#   2. requireAdminBearer on /api/admin/* (e.g. the cache-flush endpoint).
# The gate FAILS CLOSED: an unset/blank value denies every user, so both admin
# paths above simply stay denied (public site still works normally). Set it to the
# single admin email to enable them; keep it consistent with apps/admin and
# apps/workspace. Supabase RLS is still the separate data-layer check.
# NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Optional (admin shell chrome) ---
# NEXT_PUBLIC_ADMIN_DISPLAY_NAME=
# NEXT_PUBLIC_ADMIN_AVATAR_URL=
# NEXT_PUBLIC_SUPABASE_STORAGE_QUOTA_GB=1

# --- Optional: analytics + cache revalidation ---
# NEXT_PUBLIC_ANALYTICS_INGEST_SECRET=
# ANALYTICS_INGEST_SECRET=
# NEXT_PUBLIC_REVALIDATE_SECRET=
# REVALIDATE_SECRET=

# --- Optional: Upstash Redis public cache ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- NOT used by this app ---
# Outreach window reminders (SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET,
# OUTREACH_NOTIFICATION_ZONES, SITE_URL, NEXT_PUBLIC_SITE_URL) moved to the
# Workspace app in Stage E — see apps/workspace/.env.example.
