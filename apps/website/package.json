{
  "name": "@sahinpro/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public portfolio website (www.sahinpro.me)",
  "scripts": {
    "dev": "next dev",
    "start": "bun run --bun next start",
    "generate:favicons": "bun run scripts/generate-favicons.mjs",
    "generate:sitemap": "bun run scripts/generate-sitemap.mjs",
    "build": "bun run scripts/generate-favicons.mjs && bun run scripts/generate-sitemap.mjs && bun run --bun next build",
    "lint": "bunx eslint .",
    "type-check": "bunx tsc --noEmit",
