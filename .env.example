# Contact form – email deliverability (Formspree)
# -------------------------------------------------
# 1. Go to https://formspree.io and sign up (free tier is enough).
# 2. Create a new form and set the email where you want to receive messages
#    (e.g. sahinhub@gmail.com).
# 3. Formspree gives you a form URL like: https://formspree.io/f/xxxxxxxx
#    The part after /f/ is your form ID (e.g. mnqwezpy).
# 4. Create a file named .env in this project root and add:
#
#    VITE_CONTACT_FORM_ID=your_form_id_here
#
# 5. Restart the dev server (npm run dev) after changing .env.
#
# When set, form submissions are sent to Formspree and you receive real emails.
# When not set, the form still works but no email is sent (demo mode).
# -------------------------------------------------
VITE_CONTACT_FORM_ID=

# Cloudflare Turnstile – bot protection (optional)
# -------------------------------------------------
# 1. Go to https://dash.cloudflare.com → Turnstile → Add site.
# 2. Get your Site Key (public) and Secret Key (for server-side verification).
# 3. Add the Site Key here. Leave empty to disable Turnstile (form works without it).
#
#    VITE_TURNSTILE_SITE_KEY=your_site_key_here
#
# The token is sent with the form as cf-turnstile-response. To verify server-side
# (recommended), use Cloudflare's verify API with your Secret Key.
# -------------------------------------------------
VITE_TURNSTILE_SITE_KEY=
