# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Required (CMS / admin) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use one of these public keys (publishable preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Required (contact form) ---
RESEND_API_KEY=re_xxx

# --- Optional: contact ---
CONTACT_NOTIFICATION_TO_EMAIL=contact@sahinpro.me
CONTACT_NOTIFICATION_FROM_EMAIL=Sahin Alam <contact@sahinpro.me>
# RESEND_CONTACT_TEMPLATE_ID=re_xxx
# CONTACT_RATE_LIMIT_PER_MINUTE=6
# CONTACT_RATE_LIMIT_WINDOW_MS=60000

# --- Recommended: Cloudflare Turnstile (site key is public, secret is server-only) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: admin shell ---
# NEXT_PUBLIC_ADMIN_EMAIL=
# NEXT_PUBLIC_ADMIN_DISPLAY_NAME=
# NEXT_PUBLIC_ADMIN_AVATAR_URL=
# NEXT_PUBLIC_SUPABASE_STORAGE_QUOTA_GB=1

# --- Optional: analytics + cache revalidation ---
# NEXT_PUBLIC_ANALYTICS_INGEST_SECRET=
# ANALYTICS_INGEST_SECRET=
# NEXT_PUBLIC_REVALIDATE_SECRET=
# REVALIDATE_SECRET=

# --- Optional: Upstash Redis public cache ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Outreach window reminders (Supabase pg_cron → GET /api/cron/outreach-windows) ---
# Scheduler lives in the database (see supabase/migrations/20261023180000_supabase_cron_outreach_windows.sql);
# the endpoint URL and a copy of CRON_SECRET are stored in Supabase Vault, never here.
# Vault: run create_secret once per name. If you get duplicate key on secrets_name_idx,
# secrets already exist — use vault.update_secret (see migration header comments).
# Apply migration: Supabase Dashboard → SQL Editor (paste migration file), or after
# `npx supabase link --project-ref <your-ref>` run `npx supabase db push`.
# Server-only Supabase key for notification dedupe log (never expose to the browser):
# SUPABASE_SERVICE_ROLE_KEY=
# Random secret; the scheduler sends it as Authorization: Bearer <CRON_SECRET>
# (must exactly match the Vault secret 'outreach_cron_secret' and the Vercel env var)
# CRON_SECRET=
# Optional: override which zones get reminders (JSON array of { "marketId", "tz" })
# OUTREACH_NOTIFICATION_ZONES=
# Canonical production site URL used to build email links (set in Vercel for
# Production to https://www.sahinpro.me — never relies on VERCEL_URL).
# SITE_URL=https://www.sahinpro.me
# (Legacy fallback, still honoured when SITE_URL is unset)
# NEXT_PUBLIC_SITE_URL=https://www.sahinpro.me
